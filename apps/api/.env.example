# Application settings
APP_NAME=AI Expense Audit Assistant API
ENVIRONMENT=development

# Database - replace with the real PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://expense_audit:expense_audit@localhost:5432/expense_audit
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# RAG / embedding
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_SECONDS=60

# Policy document storage (resolved relative to apps/api/)
POLICY_STORAGE_DIR=storage_dump/policies
POLICY_CHUNK_SIZE=800
POLICY_CHUNK_OVERLAP=80
POLICY_SEARCH_DEFAULT_TOP_K=5
POLICY_SEARCH_MAX_TOP_K=20
POLICY_SEARCH_SIMILARITY_THRESHOLD=0.0

# LLM
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.6-flash
GEMINI_LLM_TIMEOUT_SECONDS=60
GEMINI_MAX_RETRIES=2